save-exact=true
engine-strict=true
fund=false
audit-level=high
# No dependency needs install hooks (audited 2026-10-19); never run them implicitly.
ignore-scripts=true
# Supply-chain cool-down: never resolve a package version published less than 14 days ago.
min-release-age=14

# Security fixes for upstream minimatch advisories; remove after 2026-12-01 and 2026-11-20.
min-release-age-exclude[]=minimatch
min-release-age-exclude[]=@isaacs/nonrecursive-glob-match
